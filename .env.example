# Telegram
BOT_TOKEN=000000:changeme
WEBAPP_URL=http://localhost:8080

# База
DATABASE_URL=postgresql://goal:goal@postgres:5432/goaltracker

# Auth
JWT_SECRET=change-me-to-a-long-random-string
# Telegram user id власника (Головний). Під час першого входу цей id отримає роль owner.
OWNER_TELEGRAM_ID=1001

# Демо-вхід у браузері без Telegram (для локальних скріншотів і docker без токена)
DEMO_MODE=true

# Локальні файли доказів
UPLOAD_DIR=/data/uploads
